# Multiverse Tracker: Environment Variables Configuration

# -------------------------------------------------------------
# 1. Admin Credentials (Curator Gate)
# -------------------------------------------------------------
# Set your desired admin email and password here:
NEXT_PUBLIC_ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your_secure_password_here

# -------------------------------------------------------------
# 2. Supabase Configuration (Optional - for Cloud Persistence)
# -------------------------------------------------------------
# If omitted, the app runs smoothly using the curated offline/seed datasets!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -------------------------------------------------------------
# 3. Trakt.tv OAuth 2.0 Integration (Optional - for User Sync)
# -------------------------------------------------------------
# Create an app at https://trakt.tv/oauth/applications
# Set Redirect URI to: https://your-domain.vercel.app/api/auth/trakt/callback
NEXT_PUBLIC_TRAKT_CLIENT_ID=your_trakt_client_id
TRAKT_CLIENT_SECRET=your_trakt_client_secret

# -------------------------------------------------------------
# 4. TMDB API (Optional - can also be configured via BYOK in UI)
# -------------------------------------------------------------
NEXT_PUBLIC_TMDB_API_KEY=15d2ea6d0dc1d476efbca3eba2b9bbfb
