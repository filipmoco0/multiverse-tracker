# Multiverse Tracker: Environment Variables Configuration

# -------------------------------------------------------------
# 1. Supabase Configuration (Free Tier)
# -------------------------------------------------------------
# Required for persistent cloud tracklist updates and live Admin CRUD.
# If omitted, the app runs smoothly using the curated offline/seed datasets!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin Email authorized to access /admin
NEXT_PUBLIC_ADMIN_EMAIL=admin@multiversetracker.com

# -------------------------------------------------------------
# 2. Trakt.tv OAuth 2.0 Integration
# -------------------------------------------------------------
# Create an app at https://trakt.tv/oauth/applications
# Set Redirect URI to: http://localhost:3000/api/auth/trakt/callback (or your production Vercel URL)
NEXT_PUBLIC_TRAKT_CLIENT_ID=your_trakt_client_id
TRAKT_CLIENT_SECRET=your_trakt_client_secret

# -------------------------------------------------------------
# 3. TMDB API (Optional - for Admin Metadata Auto-Fill)
# -------------------------------------------------------------
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key
